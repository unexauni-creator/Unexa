# Скопіюйте цей файл у agent/.env і заповніть. agent/.env ніколи не комітиться.

# --- Supabase → Project Settings → API ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role (або Secret key sb_secret_...), НЕ anon. Тільки для агента, ніколи не вставляйте у фронтенд.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI, який читає сторінки ---
# gemini = безкоштовно (ключ з https://aistudio.google.com), claude = платно
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash   (через кому: якщо перша зайнята, береться наступна)

# Лише якщо AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# Необов'язково: назва колонки у specialties, що посилається на universities.id
# UNEXA_SPECIALTY_FK=university_id
