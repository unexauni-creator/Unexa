   "url": "https://www.risd.edu/academics/faculty",
   "people": [
    {
     "bio": "Amy Kravitz explores animation as a distinct visual language using timing, abstraction, and movement. Her award-winning films include River Lethe, The Trap, Roost, and The Hour Coat.",
     "url": "https://www.risd.edu/academics/film-animation-video/faculty/amy-kravitz",
     "name": "Amy Kravitz",
     "role": "Professor",
     "field": "Film, Animation, Video",
     "programmes": [
      "Film / Animation / Video Bachelor's Program"
     ]
    },
    {
     "bio": "Alexandra Anthony is an independent documentary filmmaker who directs, produces, shoots, and edits her own work, including Yaya and Lost in the Bewilderness. She has also served as an editor for PBS series such as Nova and Frontline.",
     "url": "https://www.risd.edu/academics/film-animation-video/faculty/alexandra-anthony",
     "name": "Alexandra Anthony",
     "role": "Senior Critic",
     "field": "Film, Animation, Video",
     "programmes": [
      "Film / Animation / Video Bachelor's Program"
     ]
    },
    {
     "bio": "Ramon Tejada works in a hybrid design and teaching practice focused on collaboration, inclusion, and expanding design frameworks. He is a 2024 recipient of the Vilcek Prize in Design.",
     "url": "https://www.risd.edu/academics/graphic-design/faculty/ramon-tejada",
     "name": "Ramon Tejada",
     "role": "Associate Professor",
     "field": "Graphic Design",
     "programmes": [
      "Graphic Design Master's Programs"
     ]
    },
    {
     "bio": "Paul Soulellis is a graphic designer and artist whose practice encompasses experimental publishing, queer methodologies, and network culture. He is the founder of Queer.Archive.Work and Library of the Printed Web.",
     "url": "https://www.risd.edu/academics/graphic-design/faculty/paul-soulellis",
     "name": "Paul Soulellis",
     "role": "Professor",
     "field": "Graphic Design",
     "programmes": [
      "Graphic Design Master's Programs"
     ]
    },
    {
     "bio": "Pouya Ahmadi is a typographer and educator whose work interrogates language, displacement, and contested belonging. His practice includes publishing, installations, and lecture-performances.",
     "url": "https://www.risd.edu/academics/graphic-design/faculty/pouya-ahmadi",
     "name": "Pouya Ahmadi",
     "role": "Associate Professor",
     "field": "Graphic Design",
     "programmes": [
      "Graphic Design Master's Programs"
     ]
    },
    {
     "bio": "Ernesto Aparicio has worked in publishing and corporate identity design for over two decades. He served as art director for Editions du Seuil in Paris and oversees Aparicio Design, Inc.",
     "url": "https://www.risd.edu/academics/graphic-design/faculty/ernesto-aparicio",
     "name": "Ernesto Aparicio",
     "role": "Senior Critic",
     "field": "Graphic Design",
     "programmes": [
      "Graphic Design Master's Programs"
     ]
    },
    {
     "bio": "Robert Brinkerhoff is an illustrator and designer who has created work for higher education institutions and national magazines. He has previously served as head of Illustration and chief critic for RISD's European Honors Program in Rome.",
     "url": "https://www.risd.edu/academics/illustration/faculty/robert-brinkerhoff",
     "name": "Robert Brinkerhoff",
     "role": "Professor",
     "field": "Illustration",
     "programmes": [
      "Illustration Master's Program"
     ]
    },
    {
     "bio": "Jaleen Grove is an artist and art historian specializing in the history of illustration in the US and Canada. She is an associate editor of History of Illustration and the Journal of Illustration.",
     "url": "https://www.risd.edu/academics/illustration/faculty/jaleen-grove",
     "name": "Jaleen Grove",
     "role": "Associate Professor",
     "field": "Illustration",
     "programmes": [
      "Illustration Master's Program"
     ]
    },
    {
     "bio": "Rafael Attias is a multidisciplinary artist, curator, and design director working at the intersection of fine art and communication design. He has taught at RISD since 1998 and led several interdisciplinary partnered studios.",
     "url": "https://www.risd.edu/academics/illustration/faculty/rafael-attias",
     "name": "Rafael Attias",
     "role": "Senior Critic",
     "field": "Illustration",
     "programmes": [
      "Illustration Master's Program"
     ]
    },
    {
     "bio": "Leslie Fontana works in industrial design through her consulting practice les&more, creating soft goods and device designs. She has received awards from IDSA and the MIT Hacking Medicine Prize.",
     "url": "https://www.risd.edu/academics/industrial-design/faculty/leslie-fontana",
     "name": "Leslie Fontana",
     "role": "Professor",
     "field": "Industrial Design",
     "programmes": [
      "Industrial Design Master's Programs"
     ]
    },
    {
     "bio": "Tom Weis is the founder of Altimeter Design Group, exploring the intersection of design practice and global security issues. He co-designed the Doomsday Clock for the Bulletin of the Atomic Scientists.",
     "url": "https://www.risd.edu/academics/industrial-design/faculty/tom-weis",
     "name": "Tom Weis",
     "role": "Associate Professor",
     "field": "Industrial Design",
     "programmes": [
      "Industrial Design Master's Programs"
     ]
    },
    {
     "bio": "Paolo Cardini is a designer and consultant whose practice ranges from product and interaction design to strategic planning. He previously chaired industrial design departments at IED Turin.",
     "url": "https://www.risd.edu/academics/industrial-design/faculty/paolo-cardini",
     "name": "Paolo Cardini",
     "role": "Professor",
     "field": "Industrial Design",
     "programmes": [
      "Industrial Design Master's Programs"
     ]
    },
    {
     "bio": "Steven Smith is a photographer whose work chronicles the transformation of the Western landscape into suburban environments. He is a recipient of Guggenheim and Aaron Siskind Fellowships.",
     "url": "https://www.risd.edu/academics/photography/faculty/steven-smith",
     "name": "Steven Smith",
     "role": "Professor",
     "field": "Photography",
     "programmes": [
      "Photography Master's Program"
     ]
    },
    {
     "bio": "Nelson Chan is a photo-based artist and co-founder of TIS books. His work exploring immigrant identity is included in the collections of MoMA, the MET, and SFMOMA.",
     "url": "https://www.risd.edu/academics/photography/faculty/nelson-chan",
     "name": "Nelson Chan",
     "role": "Associate Professor",
     "field": "Photography",
     "programmes": [
      "Photography Master's Program"
     ]
    },
    {
     "bio": "Shana Cinquemani is an early childhood and elementary art educator and researcher. She is the founder and director of the Mini Makerz Art Studio in Providence.",
     "url": "https://www.risd.edu/academics/teaching-learning-art-design/faculty/shana-cinquemani",
     "name": "Shana Cinquemani",
     "role": "Associate Professor",
     "field": "Art Education",
     "programmes": [
      "Master of Arts in Teaching (MAT)"
     ]
    },
    {
     "bio": "Caitlin Black is a visual arts and design educator whose research focuses on community engagement, accessibility, and social justice in art education. She previously taught in public schools and at VCU.",
     "url": "https://www.risd.edu/academics/teaching-learning-art-design/faculty/caitlin-black",
     "name": "Caitlin Black",
     "role": "Assistant Professor",
     "field": "Art Education",
     "programmes": [
      "Master of Arts in Teaching (MAT)"
     ]
    }
   ],
